{
  "sourceLanguage": "tr",
  "version": "1.0",
  "strings": {
    "${applicationName} sıradaki vakit": {
      "localizations": {
        "en": {
          "stringSet": {
            "state": "translated",
            "values": [
              "Next prayer in ${applicationName}"
            ]
          }
        },
        "de": {
          "stringSet": {
            "state": "translated",
            "values": [
              "Nächstes Gebet in ${applicationName}"
            ]
          }
        }
      }
    },
    "${applicationName} sıradaki vakit ne zaman": {
      "localizations": {
        "en": {
          "stringSet": {
            "state": "translated",
            "values": [
              "When is the next prayer in ${applicationName}"
            ]
          }
        },
        "de": {
          "stringSet": {
            "state": "translated",
            "values": [
