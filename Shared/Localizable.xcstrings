    "Şu an Ramazan değil. Ramazan'da sorarsan iftara kalan süreyi söylerim.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu an Ramazan değil. Ramazan'da sorarsan iftara kalan süreyi söylerim."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It isn't Ramadan right now. Ask during Ramadan and I'll tell you how long until iftar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerade ist kein Ramadan. Frag im Ramadan, dann sage ich dir, wie lange es noch bis Iftar ist."
          }
        }
      }
    },
