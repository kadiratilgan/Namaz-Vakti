        }
      }
    },
    "Pusula hassasiyeti düşük. Telefonu havada 8 çizerek kalibre et.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pusula hassasiyeti düşük. Telefonu havada 8 çizerek kalibre et."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compass accuracy is low. Move your phone in a figure 8 to calibrate it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kompassgenauigkeit ist gering. Bewege dein Handy in Form einer 8, um ihn zu kalibrieren."
          }
        }
      }
    },
    "RAMAZAN": {
      "extractionState": "manual",
      "localizations": {
