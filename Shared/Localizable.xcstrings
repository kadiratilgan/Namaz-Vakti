    },
    "Vakitleri ve kıbleyi bulunduğun yere göre hesaplamak için konumuna ihtiyacımız var. Konumun cihazından çıkmaz.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakitleri ve kıbleyi bulunduğun yere göre hesaplamak için konumuna ihtiyacımız var. Konumun cihazından çıkmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We need your location to calculate prayer times and the Qibla for where you are. Your location never leaves your device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir brauchen deinen Standort, um Gebetszeiten und Qibla für deinen Ort zu berechnen. Dein Standort verlässt dein Gerät nicht."
          }
        }
      }
    },
