    "İçerik her gün yenilenir. Widget olarak eklemek için ana ekranda boş bir yere basılı tut ve Namaz Vakti widget'larını seç.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçerik her gün yenilenir. Widget olarak eklemek için ana ekranda boş bir yere basılı tut ve Namaz Vakti widget'larını seç."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content refreshes every day. To add it as a widget, touch and hold an empty area on your Home Screen and choose the Namaz Vakti widgets."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Inhalte erneuern sich täglich. Um sie als Widget hinzuzufügen, halte eine freie Stelle auf dem Home-Bildschirm gedrückt und wähle die Namaz-Vakti-Widgets."
          }
        }
      }
    },
