    "Vaktinde işaretlenmeyen bir namaz, ertesi gün sana sorularak kaza listesine eklenir. Kaza kıldıkça “−” ile azalt.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaktinde işaretlenmeyen bir namaz, ertesi gün sana sorularak kaza listesine eklenir. Kaza kıldıkça “−” ile azalt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A prayer that wasn't marked in time is added to your qada list after asking you the next day. Tap “−” each time you make one up."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein nicht rechtzeitig markiertes Gebet wird nach Rückfrage am nächsten Tag zur Nachholliste hinzugefügt. Tippe nach jedem Nachholen auf „−“."
          }
        }
      }
    },
