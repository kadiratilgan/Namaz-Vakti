    "Namaz Vakti": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Namaz Vakti"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Namaz Vakti"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Namaz Vakti"
          }
        }
      }
    },
    "Namaz Vakti kişisel veri toplamaz. Konumun yalnızca cihazında, namaz vakitlerini ve kıble yönünü hesaplamak için kullanılır ve hiçbir sunucuya gönderilmez. Uygulamada reklam, analiz veya takip aracı yoktur. Namaz takibi, oruç ve zikir kayıtların yalnızca cihazında saklanır. Yakındaki camiler aranırken Apple Haritalar kullanılır; bu arama Apple'ın gizlilik koşullarına tabidir.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Namaz Vakti kişisel veri toplamaz. Konumun yalnızca cihazında, namaz vakitlerini ve kıble yönünü hesaplamak için kullanılır ve hiçbir sunucuya gönderilmez. Uygulamada reklam, analiz veya takip aracı yoktur. Namaz takibi, oruç ve zikir kayıtların yalnızca cihazında saklanır. Yakındaki camiler aranırken Apple Haritalar kullanılır; bu arama Apple'ın gizlilik koşullarına tabidir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Namaz Vakti does not collect personal data. Your location is used only on your device to calculate prayer times and the Qibla direction and is never sent to a server. The app contains no ads, analytics or tracking. Your prayer, fasting and dhikr records are stored only on your device. Nearby mosques are searched with Apple Maps; that search is subject to Apple's privacy terms."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Namaz Vakti erhebt keine personenbezogenen Daten. Dein Standort wird nur auf deinem Gerät genutzt, um Gebetszeiten und die Qibla-Richtung zu berechnen, und nie an einen Server gesendet. Die App enthält keine Werbung, Analyse- oder Tracking-Tools. Deine Gebets-, Fasten- und Dhikr-Einträge werden nur auf deinem Gerät gespeichert. Moscheen in der Nähe werden mit Apple Karten gesucht; diese Suche unterliegt den Datenschutzbestimmungen von Apple."
          }
        }
      }
    },
    "Otomatik konum açık": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik konum açık"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic location on"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatischer Standort an"
          }
        }
      }
    },
    "Pusula bekleniyor…": {
      "extractionState": "manual",
      "localizations": {
