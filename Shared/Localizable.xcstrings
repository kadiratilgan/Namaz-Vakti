    "İçerik her gün yenilenir. Kaydettiklerin Keşfet › Günün içeriği › Kaydedilenler'de durur.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçerik her gün yenilenir. Kaydettiklerin Keşfet › Günün içeriği › Kaydedilenler'de durur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content refreshes every day. Your saved items are in Discover › Daily content › Saved."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Inhalte erneuern sich täglich. Gemerktes findest du unter Entdecken › Inhalt des Tages › Gemerkt."
          }
        }
      }
    },
    "“Ameller ancak niyetlere göredir. Herkese ancak niyet ettiği şey vardır.”": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Ameller ancak niyetlere göredir. Herkese ancak niyet ettiği şey vardır.”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Actions are only by intentions, and every person will have only what they intended.”"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Die Taten sind nur gemäß den Absichten, und jedem steht nur das zu, was er beabsichtigt hat.“"
          }
        }
      }
    },
    "“Rabbimiz! Bize dünyada da iyilik ver, ahirette de iyilik ver ve bizi ateş azabından koru.”": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Rabbimiz! Bize dünyada da iyilik ver, ahirette de iyilik ver ve bizi ateş azabından koru.”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Our Lord, give us good in this world and good in the Hereafter, and protect us from the punishment of the Fire.”"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Unser Herr, gib uns im Diesseits Gutes und im Jenseits Gutes und bewahre uns vor der Strafe des Feuers.“"
          }
        }
      }
    },
    "Bakara Suresi, 201": {
