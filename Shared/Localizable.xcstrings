    "“Kıldım” olarak işaretlediğin vakit için “vakit çıkmadan uyar” bildirimi gelmez. Bildirimdeki “Kıldım” butonuyla da işaretleyebilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Kıldım” olarak işaretlediğin vakit için “vakit çıkmadan uyar” bildirimi gelmez. Bildirimdeki “Kıldım” butonuyla da işaretleyebilirsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You won't get a “before it ends” alert for a prayer you've marked as prayed. You can also mark it with the “Prayed” button in the notification."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für ein als gebetet markiertes Gebet kommt keine „Vor Ablauf“-Warnung. Du kannst es auch über die Taste „Gebetet“ in der Mitteilung markieren."
          }
        }
      }
    },
