    "Vakit girdiğinde ve vakit çıkmadan önce haber verebilmemiz için bildirimlere izin ver.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakit girdiğinde ve vakit çıkmadan önce haber verebilmemiz için bildirimlere izin ver."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow notifications so we can tell you when a prayer time begins and before it ends."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Mitteilungen, damit wir dir sagen können, wann eine Gebetszeit beginnt und bevor sie endet."
          }
        }
      }
    },
