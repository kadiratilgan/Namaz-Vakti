            "state": "translated",
            "value": "Ramadan %lld"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramadan %lld"
          }
        }
      }
    },
    "Ramazan tarihleri Ümmü'l-Kurâ takvimine göre hesaplanır; Diyanet'in ilan ettiği tarihlerden bir gün farklı olabilir.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramazan tarihleri Ümmü'l-Kurâ takvimine göre hesaplanır; Diyanet'in ilan ettiği tarihlerden bir gün farklı olabilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramadan dates are calculated with the Umm al-Qura calendar and may differ by one day from the dates announced by Diyanet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ramadan-Daten werden nach dem Umm-al-Qura-Kalender berechnet und können um einen Tag von den von der Diyanet verkündeten Daten abweichen."
          }
        }
      }
    },
    "Ramazan'a kalan": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramazan'a kalan"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time until Ramadan"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeit bis Ramadan"
          }
        }
      }
    },
    "Saat ekranına Namaz Vakti komplikasyonunu ekle: halka kalan dakikayı, dikdörtgen sıradaki vakti gösterir.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ekranına Namaz Vakti komplikasyonunu ekle: halka kalan dakikayı, dikdörtgen sıradaki vakti gösterir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the Namaz Vakti complication to your watch face: the ring shows the minutes left, the rectangle the next prayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge die Namaz-Vakti-Komplikation zu deinem Zifferblatt hinzu: Der Ring zeigt die verbleibenden Minuten, das Rechteck das nächste Gebet."
          }
        }
      }
    },
    "Saat uygulaması iPhone uygulamasıyla birlikte otomatik yüklenir. Yüklenmediyse iPhone'daki Watch uygulamasından Namaz Vakti'ni aç.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat uygulaması iPhone uygulamasıyla birlikte otomatik yüklenir. Yüklenmediyse iPhone'daki Watch uygulamasından Namaz Vakti'ni aç."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The watch app installs automatically with the iPhone app. If it doesn't, open Namaz Vakti in the Watch app on your iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Watch-App wird mit der iPhone-App automatisch installiert. Falls nicht, öffne Namaz Vakti in der Watch-App deines iPhones."
          }
        }
      }
    },
    "Saat uygulamasında vakte dokununca “Kıldım” olarak işaretlenir.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat uygulamasında vakte dokununca “Kıldım” olarak işaretlenir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a prayer in the watch app to mark it as prayed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe in der Watch-App auf ein Gebet, um es als gebetet zu markieren."
          }
        }
      }
    },
