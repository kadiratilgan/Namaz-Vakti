        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Kurzbefehle-App öffnen"
          }
        }
      }
    },
    "Bir ifadeye dokununca Siri'nin cevabını yukarıda görürsün. Kurulum gerekmez: uygulama yüklenince bu kısayollar Siri'de ve Kısayollar uygulamasında hazır olur.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ifadeye dokununca Siri'nin cevabını yukarıda görürsün. Kurulum gerekmez: uygulama yüklenince bu kısayollar Siri'de ve Kısayollar uygulamasında hazır olur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a phrase to see Siri's answer above. No setup needed: once the app is installed, these shortcuts are ready in Siri and the Shortcuts app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen Satz, um oben die Antwort von Siri zu sehen. Keine Einrichtung nötig: Nach der Installation stehen die Kurzbefehle in Siri und der Kurzbefehle-App bereit."
          }
        }
      }
    },
