    "Mesafeler bu tasarımda örnektir. Uygulamada konumuna göre hesaplanır; yol tarifi Apple Haritalar'da açılır.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesafeler bu tasarımda örnektir. Uygulamada konumuna göre hesaplanır; yol tarifi Apple Haritalar'da açılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Distances in this design are examples. In the app they're calculated from your location; directions open in Apple Maps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Entfernungen sind in diesem Entwurf Beispiele. In der App werden sie anhand deines Standorts berechnet; die Route öffnet sich in Apple Karten."
          }
        }
      }
