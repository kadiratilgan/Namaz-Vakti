    "Bir adıma dokununca sayaç o zikre ve sayısına geçer. 33'e ulaşınca “Sıradaki” ile bir sonraki adıma geç.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir adıma dokununca sayaç o zikre ve sayısına geçer. 33'e ulaşınca “Sıradaki” ile bir sonraki adıma geç."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a step to switch the counter to that dhikr and its count. When you reach 33, tap “Next”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen Schritt, um den Zähler auf diesen Dhikr umzustellen. Bei 33 geht es mit „Weiter“ zum nächsten Schritt."
          }
        }
      }
    },
