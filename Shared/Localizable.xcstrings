    "Ana ekranda boş bir yere basılı tut, sol üstteki Düzenle › Widget Ekle'ye dokun ve “Namaz Vakti”ni seç. Küçük, orta, büyük ve kilit ekranı boyutları var.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana ekranda boş bir yere basılı tut, sol üstteki Düzenle › Widget Ekle'ye dokun ve “Namaz Vakti”ni seç. Küçük, orta, büyük ve kilit ekranı boyutları var."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold an empty area on your Home Screen, tap Edit › Add Widget in the top-left corner and choose “Namaz Vakti”. Available in small, medium, large and Lock Screen sizes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte eine freie Stelle auf dem Home-Bildschirm gedrückt, tippe oben links auf „Bearbeiten“ › „Widget hinzufügen“ und wähle „Namaz Vakti“. Verfügbar in klein, mittel, groß und für den Sperrbildschirm."
          }
        }
      }
    },
    "Uygulamada bu değer cihazın pusulasından otomatik gelir. Doğru sonuç için telefonu düz tutun ve metal eşyalardan uzak durun.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamada bu değer cihazın pusulasından otomatik gelir. Doğru sonuç için telefonu düz tutun ve metal eşyalardan uzak durun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the app, this value comes from your device's compass automatically. For an accurate result, hold your phone flat and keep it away from metal objects."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der App kommt dieser Wert automatisch vom Kompass deines Geräts. Für ein genaues Ergebnis halte dein Handy waagerecht und fern von Metallgegenständen."
          }
        }
      }
    },
    "Her vakit için hatırlatma, ses ve “vakit çıkmadan” uyarısı": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her vakit için hatırlatma, ses ve “vakit çıkmadan” uyarısı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminder, sound and “before it ends” alert for each prayer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerung, Ton und „Vor Ablauf“-Warnung für jedes Gebet"
          }
        }
      }
    },
