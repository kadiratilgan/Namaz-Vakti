          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrives as a gentle tap on your wrist, so you won't miss a prayer even with your phone silenced or in your pocket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommt als sanftes Tippen am Handgelenk – so verpasst du kein Gebet, auch wenn das Handy stumm oder in der Tasche ist."
