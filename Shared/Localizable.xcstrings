    "Seferîlik bilgisi yalnızca hatırlatma amaçlıdır; dini hükümler için bir din görevlisine danış.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seferîlik bilgisi yalnızca hatırlatma amaçlıdır; dini hükümler için bir din görevlisine danış."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The traveller note is only a reminder; ask a religious scholar about rulings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Reisehinweis ist nur eine Erinnerung; frage zu religiösen Urteilen eine Gelehrte oder einen Gelehrten."
          }
        }
      }
    },
    "Seçilen namaz vaktinin saatini söyler.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen namaz vaktinin saatini söyler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tells you the time of the chosen prayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nennt die Zeit des gewählten Gebets."
          }
        }
      }
    },
    "Sıradaki namaz vaktini ve kalan süreyi söyler.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıradaki namaz vaktini ve kalan süreyi söyler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tells you the next prayer and the time left."
