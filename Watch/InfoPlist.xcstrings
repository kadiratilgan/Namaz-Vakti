    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Namaz vakitlerini bulunduğun yere göre hesaplamak için konumunu kullanırız."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We use your location to calculate prayer times for where you are."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir nutzen deinen Standort, um die Gebetszeiten für deinen Ort zu berechnen."
          }
        }
      }
    }
